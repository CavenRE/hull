#!/bin/bash
set -euo pipefail

export APP_DIR="${APP_DIR:-$HOME/.hull}"
source "$APP_DIR/setup/ui.sh"

if [ $# -lt 1 ]; then
    echo "Usage: hull import <name> [options]" >&2
    info "Example: hull import my-old-app"
    info "Example: hull import my-old-app --laravel --db=mysql"
    exit 1
fi

NAME=$1
shift

TEMPLATE=""
if [[ "${1:-}" == --* ]] && [[ ! "${1:-}" =~ ^--(db|no-db|with-redis|interactive|version|interactive|-i|-v) ]]; then
    TEMPLATE=${1#--}
    shift
fi

DB=""
WITH_REDIS=false
INTERACTIVE_INFRA=false
VERSION=""
PROMPT_VERSION=false
DB_EXPLICIT=false

for arg in "$@"; do
    case $arg in
        --db=*)
        DB="${arg#*=}"
        DB_EXPLICIT=true
        ;;
        --no-db)
        DB="none"
        DB_EXPLICIT=true
        ;;
        --with-redis)
        WITH_REDIS=true
        ;;
        --interactive|-i)
        INTERACTIVE_INFRA=true
        ;;
        --version=*)
        VERSION="${arg#*=}"
        ;;
        --version|-v)
        PROMPT_VERSION=true
        ;;
        *)
        echo "Warning: Unknown flag $arg" >&2
        ;;
    esac
done

if [[ ! "$NAME" =~ ^[a-zA-Z0-9-]+$ ]]; then
    fatal "Site name can only contain alphanumeric characters and hyphens."
fi

if [[ -n "$TEMPLATE" ]] && [[ ! "$TEMPLATE" =~ ^[a-zA-Z0-9-]+$ ]]; then
    fatal "Template name can only contain alphanumeric characters and hyphens."
fi

set -a
source "$APP_DIR/.env"
set +a

TARGET="$SITES_DIR/$NAME"

if [ ! -d "$TARGET" ]; then
    fatal "Directory $TARGET does not exist. Move your existing project to $SITES_DIR/$NAME first."
fi

if [ -z "$TEMPLATE" ]; then
    step "Auto-Detecting Framework"
    if [ -f "$TARGET/artisan" ] || ( [ -f "$TARGET/composer.json" ] && grep -q "laravel/framework" "$TARGET/composer.json" ); then
        TEMPLATE="laravel"
        info "Detected framework: Laravel"
    elif [ -f "$TARGET/wp-config.php" ] || [ -f "$TARGET/wp-config-sample.php" ] || [ -d "$TARGET/wp-includes" ]; then
        TEMPLATE="wordpress"
        info "Detected framework: WordPress"
    else
        TEMPLATE="plain"
        info "Detected framework: Plain PHP"
    fi
fi

if [ ! -f "$APP_DIR/templates/base/$TEMPLATE.yaml" ]; then
    fatal "Base template '$TEMPLATE' not found in $APP_DIR/templates/base"
fi

step "Analyzing Project State"
cd "$TARGET"

# 1. Dependency Sniffing (PHP Version)
PHP_VER="8.4"
if [ -z "$VERSION" ] && [ "$PROMPT_VERSION" = false ]; then
    if [ "$TEMPLATE" == "laravel" ] || [ "$TEMPLATE" == "plain" ]; then
        if [ -f "composer.json" ] && command -v jq &> /dev/null; then
            PHP_REQ=$(jq -r '.require.php // empty' composer.json || echo "")
            if [[ "$PHP_REQ" == *"8.1"* ]]; then PHP_VER="8.1"; fi
            if [[ "$PHP_REQ" == *"8.2"* ]]; then PHP_VER="8.2"; fi
            if [[ "$PHP_REQ" == *"8.3"* ]]; then PHP_VER="8.3"; fi
            if [[ "$PHP_REQ" == *"8.4"* ]]; then PHP_VER="8.4"; fi
            info "Detected PHP requirement: $PHP_REQ -> Mapping to serversideup/php:${PHP_VER}-fpm-nginx"
        else
            info "No composer.json found or jq not installed. Defaulting to PHP 8.4."
        fi
    fi
else
    # If explicitly asked for a version via flag, we skip auto-detect.
    true
fi

# 2. State Sniffing (Infrastructure)
DB_NAME="hull_db"
if [ "$TEMPLATE" == "laravel" ] && [ -f ".env" ]; then
    EXTRACTED=$(grep -E "^DB_DATABASE=" ".env" | cut -d'=' -f2 | tr -d '"'\'' ' || true)
    if [ -n "$EXTRACTED" ] && [ "$EXTRACTED" != "null" ]; then
        DB_NAME="$EXTRACTED"
        info "Extracted database name '$DB_NAME' from .env"
    fi
elif [ "$TEMPLATE" == "wordpress" ] && [ -f "wp-config.php" ]; then
    EXTRACTED=$(grep -E "define\(\s*'DB_NAME'" "wp-config.php" | cut -d"'" -f4 || true)
    if [ -n "$EXTRACTED" ]; then
        DB_NAME="$EXTRACTED"
        info "Extracted database name '$DB_NAME' from wp-config.php"
    fi
fi

if [ "$DB_EXPLICIT" = false ] && [ "$INTERACTIVE_INFRA" = false ]; then
    # Sniff from .env first
    if [ -f ".env" ]; then
        if grep -q "^DB_CONNECTION=pgsql" .env; then
            DB="postgres"
            info "Detected DB_CONNECTION=pgsql -> Selecting PostgreSQL mix-in"
        elif grep -q "^DB_CONNECTION=mysql" .env; then
            DB="mysql"
            info "Detected DB_CONNECTION=mysql -> Selecting MySQL mix-in"
        elif grep -q "^DB_CONNECTION=mariadb" .env; then
            DB="mariadb"
            info "Detected DB_CONNECTION=mariadb -> Selecting MariaDB mix-in"
        fi

        if grep -q "^REDIS_HOST=" .env || grep -q "^CACHE_STORE=redis" .env; then
            WITH_REDIS=true
            info "Detected Redis configuration -> Selecting Redis mix-in"
        fi
    elif [ "$TEMPLATE" == "wordpress" ] && [ -f "wp-config.php" ]; then
        DB="mariadb"
        info "Detected WordPress wp-config.php -> Defaulting to MariaDB mix-in"
    fi
    
    # Smart Defaults Fallback
    if [ -z "$DB" ]; then
        if [ "$TEMPLATE" == "laravel" ]; then
            DB="postgres"
            info "Applying smart default: PostgreSQL injected for Laravel."
        elif [ "$TEMPLATE" == "wordpress" ]; then
            DB="mariadb"
            info "Applying smart default: MariaDB injected for WordPress."
        elif [ "$TEMPLATE" == "plain" ]; then
            DB="none"
        fi
    fi
fi

if [ "$DB" == "none" ]; then
    DB=""
fi

if [ "$PROMPT_VERSION" = true ]; then
    if command -v fzf &> /dev/null; then
        if [ "$TEMPLATE" == "wordpress" ]; then
            OPTIONS="latest\n6.4\n6.3"
        else
            OPTIONS="8.4\n8.3\n8.2\n8.1"
        fi
        VERSION=$(echo -e "$OPTIONS" | fzf --prompt="Select $TEMPLATE version: " || true)
    fi
fi

if [ "$INTERACTIVE_INFRA" = true ]; then
    echo -e "\033[1;34mInteractive Infrastructure Selection\033[0m"
    echo "Use SPACE to select/deselect, ENTER to confirm. Leave blank for framework defaults."

    OPTIONS="PostgreSQL\nMySQL\nMariaDB\nRedis"
    SELECTED=$(echo -e "$OPTIONS" | fzf --multi --marker="> " --prompt="Select optional infrastructure: " || true)

    if [[ "$SELECTED" == *"PostgreSQL"* ]]; then DB="postgres"; fi
    if [[ "$SELECTED" == *"MySQL"* ]]; then DB="mysql"; fi
    if [[ "$SELECTED" == *"MariaDB"* ]]; then DB="mariadb"; fi
    if [[ "$SELECTED" == *"Redis"* ]]; then WITH_REDIS=true; fi

    if [ -z "$DB" ] && [ "$WITH_REDIS" = false ]; then
        if [ "$TEMPLATE" == "wordpress" ]; then
            echo -e "\033[1;33mApplying smart default: MariaDB injected for WordPress.\033[0m"
            DB="mariadb"
        elif [ "$TEMPLATE" == "laravel" ]; then
            echo -e "\033[1;33mApplying smart default: PostgreSQL injected for Laravel.\033[0m"
            DB="postgres"
        fi
    fi
fi

step "Assembling Infrastructure Blueprint"

cp "$APP_DIR/templates/base/$TEMPLATE.yaml" "$TARGET/compose.yaml"

if [ -n "$VERSION" ] && [ "$VERSION" != "latest" ]; then
    if [ "$TEMPLATE" == "wordpress" ]; then
        sed -i "s|image: wordpress:latest|image: wordpress:${VERSION}|g" "$TARGET/compose.yaml"
    elif [ "$TEMPLATE" == "plain" ] || [ "$TEMPLATE" == "laravel" ]; then
        sed -i "s|image: serversideup/php:8.4-fpm-nginx|image: serversideup/php:${VERSION}-fpm-nginx|g" "$TARGET/compose.yaml"
    fi
elif [ -n "$PHP_VER" ] && [ "$PHP_VER" != "8.4" ]; then
    sed -i "s|image: serversideup/php:8.4-fpm-nginx|image: serversideup/php:${PHP_VER}-fpm-nginx|g" "$TARGET/compose.yaml"
fi

inject_mixin() {
    local MIXIN="$1"
    if [ ! -f "$MIXIN" ]; then
        fatal "Mix-in '$MIXIN' not found."
    fi

    yq eval-all '. as $item ireduce ({}; . * $item )' "$TARGET/compose.yaml" "$MIXIN" > "$TARGET/compose.tmp.yaml"
    mv "$TARGET/compose.tmp.yaml" "$TARGET/compose.yaml"
}

set_env() {
    local key=$1
    local val=$2
    local file=${3:-.env}
    if grep -q "^${key}=" "$file"; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$file"
    elif grep -q "^# ${key}=" "$file"; then
        sed -i "s|^# ${key}=.*|${key}=${val}|" "$file"
    else
        echo "${key}=${val}" >> "$file"
    fi
}

if [ -n "$DB" ]; then
    inject_mixin "$APP_DIR/templates/services/$DB.yaml"
    # Ensure database is named correctly
    sed -i "s|hull_db|$DB_NAME|g" "$TARGET/compose.yaml"
fi

if [ "$WITH_REDIS" = true ]; then
    inject_mixin "$APP_DIR/templates/services/redis.yaml"
fi

sed -i "s|{{SITE_NAME}}|$NAME|g" "$TARGET/compose.yaml"
sed -i "s|{{TLD}}|${TLD:-test}|g" "$TARGET/compose.yaml"
success "Docker blueprints assembled dynamically."

step "Configuring Framework Hooks"

if [ "$TEMPLATE" == "laravel" ] && [ -f ".env" ]; then
    cp .env .env.hull-backup
    set_env DB_HOST db
    set_env DB_DATABASE "$DB_NAME"

    if [ -n "$DB" ]; then
        if [ "$DB" == "postgres" ]; then
            set_env DB_CONNECTION pgsql
            set_env DB_PORT 5432
            set_env DB_USERNAME postgres
            set_env DB_PASSWORD ""
        elif [ "$DB" == "mysql" ]; then
            set_env DB_CONNECTION mysql
            set_env DB_PORT 3306
            set_env DB_USERNAME root
            set_env DB_PASSWORD ""
        elif [ "$DB" == "mariadb" ]; then
            set_env DB_CONNECTION mariadb
            set_env DB_PORT 3306
            set_env DB_USERNAME root
            set_env DB_PASSWORD ""
        fi
    fi

    if [ "$WITH_REDIS" = true ]; then
        set_env REDIS_HOST redis
        set_env CACHE_STORE redis
        set_env SESSION_DRIVER redis
        set_env QUEUE_CONNECTION redis
    fi
    success "Laravel .env updated for Docker (Backup saved as .env.hull-backup)."
fi

if [ "$TEMPLATE" == "wordpress" ] && [ -f "wp-config.php" ]; then
    cp wp-config.php wp-config.php.hull-backup
    sed -i "s|define( *'DB_HOST', *'.*' *);|define( 'DB_HOST', 'db' );|" wp-config.php
    sed -i "s|define( *'DB_NAME', *'.*' *);|define( 'DB_NAME', '$DB_NAME' );|" wp-config.php
    sed -i "s|define( *'DB_PASSWORD', *'.*' *);|define( 'DB_PASSWORD', '' );|" wp-config.php
    sed -i "s|WORDPRESS_DB_NAME: wordpress|WORDPRESS_DB_NAME: $DB_NAME|g" compose.yaml || true

    if ! grep -q "HTTP_X_FORWARDED_PROTO" wp-config.php; then
        PROXY_FIX="<?php\n\n// Hull Reverse Proxy Fix\nif (isset(\$_SERVER['HTTP_X_FORWARDED_PROTO']) \&\& strpos(\$_SERVER['HTTP_X_FORWARDED_PROTO'], 'https') !== false) {\n    \$_SERVER['HTTPS'] = 'on';\n}\n"
        sed -i "0,/<?php/s|<?php|$PROXY_FIX|" wp-config.php
    fi

    success "WordPress wp-config.php updated for Docker (Backup saved as wp-config.php.hull-backup)."
fi

info "Booting environment..."
docker compose up -d

shopt -s nullglob
SQL_FILES=(*.sql *.sql.gz *.zip)
shopt -u nullglob

if [ ${#SQL_FILES[@]} -gt 0 ] && [ -n "$DB" ]; then
    echo ""
    OPTIONS=""
    for file in "${SQL_FILES[@]}"; do
        OPTIONS+="$file\n"
    done
    OPTIONS+="Skip Import"

    SELECTED_FILE=$(echo -e "$OPTIONS" | fzf --prompt="Select database dump to import: ")

    if [ -n "$SELECTED_FILE" ] && [ "$SELECTED_FILE" != "Skip Import" ]; then
        info "Waiting for database engine to initialize..."
        
        MAX_RETRIES=30
        RETRY_COUNT=0
        READY=false
        
        while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
            if [ "$DB" == "postgres" ]; then
                if docker compose exec -T db pg_isready -U postgres >/dev/null 2>&1; then
                    READY=true
                    break
                fi
            elif [ "$DB" == "mysql" ] || [ "$DB" == "mariadb" ]; then
                DB_CMD="mysql"
                if [ "$DB" == "mariadb" ]; then DB_CMD="mariadb"; fi
                if docker compose exec -T db $DB_CMD -u root -e "SELECT 1" >/dev/null 2>&1; then
                    READY=true
                    break
                fi
            fi
            sleep 1
            RETRY_COUNT=$((RETRY_COUNT+1))
        done
        
        if [ "$READY" = false ]; then
            warning "Database engine did not become ready in time. Import may fail."
        fi

        info "Importing database from $SELECTED_FILE into $DB_NAME..."
        EXT="${SELECTED_FILE##*.}"
        CMD=""
        if [ "$EXT" == "gz" ]; then
            CMD="zcat \"$SELECTED_FILE\""
        elif [ "$EXT" == "zip" ]; then
            CMD="unzip -p \"$SELECTED_FILE\""
        else
            CMD="cat \"$SELECTED_FILE\""
        fi
        
        # Strip out CREATE DATABASE and USE statements to prevent 'database exists' errors
        CMD="$CMD | sed -e '/^[[:space:]]*CREATE DATABASE/Id' -e '/^[[:space:]]*USE /Id'"

        if [ "$DB" == "postgres" ]; then
            if eval "$CMD" | docker compose exec -T db psql -U postgres -d "$DB_NAME"; then
                success "Database imported successfully."
            else
                warning "Database import encountered an error."
            fi
        elif [ "$DB" == "mysql" ] || [ "$DB" == "mariadb" ]; then
            DB_CMD="mysql"
            if [ "$DB" == "mariadb" ]; then
                DB_CMD="mariadb"
            fi
            if eval "$CMD" | docker compose exec -T db $DB_CMD -f -u root "$DB_NAME"; then
                success "Database imported successfully."
            else
                warning "Database import encountered an error."
            fi
        fi
    else
        info "Skipping database import."
    fi
fi

step "Import Complete"
success "Your app is now running at https://$NAME.${TLD:-test}"