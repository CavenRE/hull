#!/bin/bash

if [ -f "artisan" ]; then
    CONTAINER=$(docker compose ps --services | grep -E '^(app|php|laravel)$' | head -n 1)
    if [ -z "$CONTAINER" ]; then
        echo "Error: Could not detect the PHP/App container."
        exit 1
    fi
    docker compose exec "$CONTAINER" php artisan "$@"
else
    echo "Error: artisan file not found in current directory."
    exit 1
fi
