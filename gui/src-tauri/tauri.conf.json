{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hull",
  "version": "0.1.0",
  "identifier": "app.hull.gui",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hull",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 540,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hull",
    "shortDescription": "Docker-based local dev environments",
    "longDescription": "Hull provisions Docker-based local development environments with automatic HTTPS domains, databases, and framework scaffolding.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/hulld", "binaries/hull"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
