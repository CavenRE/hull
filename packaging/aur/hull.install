# Hull pacman hooks. Grant the daemon permission to bind 80/443 without root,
# and point the user at the one-time setup.

_grant_caps() {
  if command -v setcap >/dev/null 2>&1; then
    setcap 'cap_net_bind_service=+ep' /usr/bin/hull 2>/dev/null || true
  fi
}

post_install() {
  _grant_caps
  cat <<'EOF'

Hull installed. Next steps:
  hull setup     # router, DNS and local CA; starts Hull and runs it at login
  hull doctor    # check the result

`hull setup` points *.test at Hull's loopback IP (127.0.0.2 by default) through
systemd-resolved or NetworkManager + dnsmasq, whichever this machine uses.
EOF
}

post_upgrade() {
  _grant_caps
}
