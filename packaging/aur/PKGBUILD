# Maintainer: CavenRE <caven.erasmus@gmail.com>
#
# hull , the CLI (`hull`) + daemon (`hulld`) + systemd --user unit.
#
# Install:  pacman -S hull        (or: yay -S hull)
#
# This builds from a tagged release tarball. For a tip-of-tree package, copy
# this to a `hull-git` PKGBUILD: set pkgname=hull-git, source the git repo, and
# add a pkgver() using `git describe`.

pkgname=hull
pkgver=0.9.5
pkgrel=1
pkgdesc='A local environment for your sites & apps , native router, DNS and services'
arch=('x86_64' 'aarch64')
url='https://github.com/CavenRE/hull'
license=('MIT')
makedepends=('go' 'git')
depends=('docker' 'docker-compose')
install=hull.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/CavenRE/hull/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # run `updpkgsums` before publishing to pin the checksum

_srcdir="$pkgname-$pkgver"

prepare() {
  cd "$_srcdir"
  # Cache modules inside the build dir so build() needs no network on rebuilds
  # and makepkg can clean up after itself.
  export GOPATH="$srcdir/gopath"
  go mod download
}

build() {
  cd "$_srcdir"
  export GOPATH="$srcdir/gopath"
  export CGO_CPPFLAGS="${CPPFLAGS}" CGO_CFLAGS="${CFLAGS}" CGO_CXXFLAGS="${CXXFLAGS}" CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS='-buildmode=pie -mod=readonly -modcacherw'

  local ldflags="-s -w \
    -X github.com/CavenRE/hull/internal/version.Version=$pkgver \
    -X github.com/CavenRE/hull/internal/version.Commit=aur"

  go build -ldflags "$ldflags" -o build/hull  ./cmd/hull
}

package() {
  cd "$_srcdir"

  install -Dm755 build/hull  "$pkgdir/usr/bin/hull"

  # systemd --user unit (enable with: systemctl --user enable --now hulld)
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/hulld.service" <<'EOF'
[Unit]
Description=Hull daemon (local router, DNS, services)
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/hull daemon run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
EOF

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
